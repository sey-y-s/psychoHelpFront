
<div class="container mt-5" id="conteneur">
    <div class="d-flex justify-content-center mb-4">
        <div class="zone-illustration">
            <div class="fond-ovale"></div>
            <img src="main-serrer.png" class="icone-mains" alt="icone">
        </div>
    </div>

    <div id="contenu">
        <h2>{{conseil.titre}}</h2>

        <div id="description">
            <p>{{conseil.description}}</p>
        </div>
        <div class="align-items-end " id="auteur">
            <p>Auteur : <strong>{{conseil.auteur}}</strong> </p>
        </div>
        <div class="d-flex justify-content-between" id="ligne">
            <p>date {{conseil.datePublication}}</p>
            <p>Psychologue : {{conseil.psyNom}}</p>
        </div>
{{getConseil(1)}}
        <div class="d-flex justify-content-center my-4">
            <div class="custom-switch"
                 [class.bg-valide]="estValide"
                 [class.bg-non-valide]="!estValide"
                 (click)="toggleStatut()">

                <div class="pastille-blanche" [class.glisse-droite]="estValide">
                    {{ estValide ? 'validé' : 'non validé' }}
                </div>

            </div>
        </div>





    </div>


</div>
