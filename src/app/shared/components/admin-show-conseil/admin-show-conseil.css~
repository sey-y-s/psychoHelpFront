
#conteneur{
    width: 100%;
    height: 100%;
    border-radius: 15px;
    box-shadow: 4px 4px 20px rgba(0, 0, 0, 0.25);
    background: white;
    padding: 40px 0px 20px 0px;


}

#icone-fond{
    box-sizing: border-box;
    position: absolute;
    width: 20vw;
    height: 22vh;
    left: 767px;
    top: 137px;

    background: #D7A790;
    opacity: 0.37;
    border: 1px solid #2C3E50;
    transform: matrix(1, -0.06, 0.06, 1, 0, 0);

    border-radius: 50%;
}

.max-width-card {
    max-width: 600px;
    background-color: #ffffff;
    padding: 30px;
}
.zone-illustration {
    position: relative;
    width: 180px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.fond-ovale {
    position: absolute;
    width: 18vw;
    height: 18vh;
    background-color: #f5e6df;
    border-radius: 50%;
    z-index: 1;
    transform: rotate(-10deg);
}

.icone-mains {
    position: relative;
    width: 14vw;
    height: auto;
    z-index: 2;
    transform: translateY(-5px);
}
.texte-titre {
    color: #243447;
    font-size: 28px;
}

.texte-desc {
    color: #5c6b73;
    font-size: 14px;
    line-height: 1.6;
}

.texte-metas {
    font-size: 13px;
}

#contenu h2{
    text-align: center;

    width: 700px;
    margin: 18px auto;
}
#description p{
    text-align: center;
    width: 700px;
    margin: 18px auto;
}

#auteur p{
    text-align: end;
    margin: 20px;
    width: 700px;
    margin: auto;
    padding-right: 10px;
}
#ligne p{
    text-align: center;
    margin: 20px;
}
#ligne{
    width: 700px;

    margin: 65px auto;
}


.custom-switch {
    position: relative;
    width: 200px;
    height: 50px;
    border-radius: 50px;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    user-select: none;
    transition: background-color 0.3s ease;
}

.bg-non-valide {
    background-color: #fdd2be;
    border: 1px solid #fcae91;
}

.bg-valide {
    background-color: #cbf3d2;
    border: 1px solid #a3e9b1;
}

.pastille-blanche {
    position: absolute;
    left: 4px;
    width: 110px;
    height: calc(100% - 8px);
    background-color: #ffffff;
    border-radius: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: sans-serif;
    font-size: 15px;
    color: #000000;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.glisse-droite {
    transform: translateX(78px);
}
